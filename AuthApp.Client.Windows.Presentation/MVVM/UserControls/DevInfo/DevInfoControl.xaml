<UserControl
    x:Class="AuthApp.Client.Windows.Presentation.MVVM.UserControls.DevInfo.DevInfoControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AuthApp.Client.Windows.Presentation.MVVM.UserControls.DevInfo"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid x:Name="gridRectangles" IsHitTestVisible="False">
            <Rectangle
                Width="100"
                Height="100"
                Margin="130,220,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="Green"
                Opacity="0.3"
                RadiusX="100"
                RadiusY="100">

                <Rectangle.RenderTransform>
                    <RotateTransform Angle="20" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <Rectangle
                Width="500"
                Height="200"
                Margin="-100,0,-500,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="Orange"
                Opacity="0.5"
                RadiusX="20"
                RadiusY="20">

                <Rectangle.RenderTransform>
                    <RotateTransform Angle="-20" />
                </Rectangle.RenderTransform>
            </Rectangle>

            <Rectangle
                Width="100"
                Height="200"
                Margin="215,100,-500,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Fill="DarkSlateBlue"
                Opacity="0.2"
                RadiusX="20"
                RadiusY="20" />
        </Grid>

        <StackPanel>
            <TextBlock
                FontSize="{StaticResource Header1_FontSize}"
                FontWeight="Bold"
                Text="{DynamicResource DevFullName}" />

            <TextBlock Margin="{StaticResource Top_Big_Margin}" Text="{DynamicResource BirthDate}" />
            <TextBox
                Margin="{StaticResource Top_Tiny_Margin}"
                IsReadOnly="True"
                Style="{StaticResource RoundedTextBoxStyle}"
                Text="{DynamicResource BirthDateValue}" />

            <TextBlock Margin="{StaticResource Top_Normal_Margin}" Text="{DynamicResource Email}" />
            <TextBox
                Margin="{StaticResource Top_Tiny_Margin}"
                IsReadOnly="True"
                Style="{StaticResource RoundedTextBoxStyle}"
                Text="aws.lev@gmail.com" />

            <TextBlock Margin="{StaticResource Top_Normal_Margin}" Text="{DynamicResource Phone}" />
            <TextBox
                Margin="{StaticResource Top_Tiny_Margin}"
                IsReadOnly="True"
                Style="{StaticResource RoundedTextBoxStyle}"
                Text="+375291821630" />

            <TextBlock
                Margin="{StaticResource Top_Big_Margin}"
                FontSize="{StaticResource Header4_FontSize}"
                FontWeight="Bold"
                Text="{DynamicResource DevAdditionalMessage}" />
        </StackPanel>
    </Grid>

</UserControl>
