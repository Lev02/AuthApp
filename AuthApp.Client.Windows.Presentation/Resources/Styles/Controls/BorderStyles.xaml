<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="LightBackgroundBorderStyle" TargetType="{x:Type Border}">
        <Setter Property="Background" Value="{DynamicResource LightOverlayBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource NormalCornerRadius}" />
        <Setter Property="Padding" Value="{StaticResource Big_Margin}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource NormalOverlayBrush}" />
    </Style>
</ResourceDictionary>