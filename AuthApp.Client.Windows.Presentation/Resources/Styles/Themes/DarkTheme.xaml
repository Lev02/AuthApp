<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Dark Theme Colors  -->
    <Color x:Key="PrimaryBackgroundColor">#FF1E1E1E</Color>
    <Color x:Key="SecondaryBackgroundColor">#FF2E2E2E</Color>

    <Color x:Key="PrimaryButtonColor">#FF007ACC</Color>
    <Color x:Key="SecondaryButtonColor">#FF2E2E2E</Color>

    <Color x:Key="PrimaryTextColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryTextColor">#FFB0B0B0</Color>

    <Color x:Key="LightOverlayColor">#07FFFFFF</Color>

    <Color x:Key="NormalOverlayColor">#20FFFFFF</Color>

    <!--  Dark Theme Brushes  -->
    <SolidColorBrush
        x:Key="PrimaryBackgroundBrush"
        x:Name="PrimaryBackgroundBrush"
        Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush
        x:Key="SecondaryBackgroundBrush"
        x:Name="SecondaryBackgroundBrush"
        Color="{StaticResource SecondaryBackgroundColor}" />

    <SolidColorBrush
        x:Key="PrimaryButtonBrush"
        x:Name="PrimaryButtonBrush"
        Color="{StaticResource PrimaryButtonColor}" />
    <SolidColorBrush
        x:Key="SecondaryButtonBrush"
        x:Name="SecondaryButtonBrush"
        Color="{StaticResource SecondaryButtonColor}" />

    <SolidColorBrush
        x:Key="PrimaryTextBrush"
        x:Name="PrimaryTextBrush"
        Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush
        x:Key="SecondaryTextBrush"
        x:Name="SecondaryTextBrush"
        Color="{StaticResource SecondaryTextColor}" />

    <SolidColorBrush
        x:Key="LightOverlayBrush"
        x:Name="LightOverlayBrush"
        Color="{StaticResource LightOverlayColor}" />
    <SolidColorBrush
        x:Key="NormalOverlayBrush"
        x:Name="NormalOverlayBrush"
        Color="{StaticResource NormalOverlayColor}" />
</ResourceDictionary>