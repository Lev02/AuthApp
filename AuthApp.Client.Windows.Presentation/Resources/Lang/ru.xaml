<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!--  Auth  -->
    <sys:String x:Key="SignIn">Вход</sys:String>
    <sys:String x:Key="SigningIn">Вход...</sys:String>
    <sys:String x:Key="NoAccount">Нет аккаунта?</sys:String>
    <sys:String x:Key="SignUp">Регистрация</sys:String>
    <sys:String x:Key="SigningUp">Регистрация...</sys:String>
    <sys:String x:Key="SignOut">Выход</sys:String>
    <sys:String x:Key="SigningOut">Выход...</sys:String>
    <sys:String x:Key="InvalidAuthData">Неверные данные</sys:String>

    <!--  Dev data  -->
    <sys:String x:Key="DevInfo">Данные разработчика</sys:String>
    <sys:String x:Key="DevFullName">Лев Аксёнов</sys:String>
    <sys:String x:Key="BirthDate">Дата рождения</sys:String>
    <sys:String x:Key="BirthDateValue">7 декабря 2002</sys:String>
    <sys:String x:Key="DevAdditionalMessage">Спасибо за задание, теперь поговорим о работе :)</sys:String>

    <!--  User Data  -->
    <sys:String x:Key="UserInfo">Данные пользователя</sys:String>
    <sys:String x:Key="ID">ID</sys:String>
    <sys:String x:Key="FirstName">Имя</sys:String>
    <sys:String x:Key="LastName">Фамилия</sys:String>
    <sys:String x:Key="Email">Email</sys:String>
    <sys:String x:Key="Phone">Телефон</sys:String>
    <sys:String x:Key="Username">Логин</sys:String>
    <sys:String x:Key="Password">Пароль</sys:String>
    <sys:String x:Key="EmptyUserData">Войдите или зарегистрируйтесь для отображения информации</sys:String>

    <!--  Sign Up  -->
    <sys:String x:Key="FirstNameNotValid">Имя имеет неверный формат</sys:String>
    <sys:String x:Key="LastNameNotValid">Фамилия имеет неверный формат</sys:String>
    <sys:String x:Key="EmailNotValid">Email имеет неверный формат</sys:String>
    <sys:String x:Key="PhoneNotValid">Телефон имеет неверный формат</sys:String>
    <sys:String x:Key="UsernameNotValid">Логин имеет неверный формат</sys:String>
    <sys:String x:Key="PasswordNotValid">Пароль имеет неверный формат</sys:String>
</ResourceDictionary>